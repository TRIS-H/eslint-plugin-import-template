{
  "name": "eslint-plugin-import-template",
  "type": "module",
  "version": "1.0.1",
  "description": "ESLint plugin for checking unresolved static asset paths in Vue SFC templates.",
  "author": "TRIS-H <2218975525@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/TRIS-H/eslint-plugin-import-template#readme",
  "bugs": {
    "url": "https://github.com/TRIS-H/eslint-plugin-import-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TRIS-H/eslint-plugin-import-template.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint-rule",
    "vue",
    "vue3",
    "vue-sfc",
    "vue-template",
    "vue-eslint-parser",
    "assets",
    "static-assets",
    "asset-check",
    "asset-exists",
    "template-assets",
    "unresolved-import",
    "no-unresolved",
    "src",
    "href",
    "src-href",
    "path-alias",
    "alias",
    "import",
    "template"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "vue-eslint-parser": "^10.1.4"
  }
}
